[Unit]
Description=Stoatmod dashboard API
After=network.target

[Service]
Type=simple
User=stoatmod
WorkingDirectory=/opt/stoatmod
EnvironmentFile=/opt/stoatmod/.env
EnvironmentFile=/opt/stoatmod/api/.env
ExecStart=/opt/stoatmod/.venv/bin/python /opt/stoatmod/api/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stoatmod

[Install]
WantedBy=multi-user.target
