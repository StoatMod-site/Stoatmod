# Stoat user ID allowed to run Stoatmod's global owner commands.
GLOBAL_COMMAND_OWNER_ID=

STOAT_BOT_TOKEN=
LOCAL_AI_BASE_URL=http://127.0.0.1:18006
# Must equal the "version" reported by the model service's /health endpoint.
LOCAL_AI_EXPECTED_VERSION=
LOCAL_AI_API_KEY=

MODERATION_THRESHOLD=0.9
MODERATION_MAX_IMAGE_BYTES=10485760
MODERATION_CONCURRENCY=3
MODERATION_TIMEOUT_SECONDS=45

MODERATION_SERVER_IDS=
MODERATION_CHANNEL_IDS=
MODERATION_NOTIFICATION=warn
SPAM_REPEAT_COUNT=3
SPAM_REPEAT_WINDOW_SECONDS=30
SPAM_RAPID_COUNT=5
SPAM_RAPID_WINDOW_SECONDS=10
SPAM_SCORE_THRESHOLD=7
SPAM_SCORE_HALF_LIFE_SECONDS=30
MASS_MENTION_LIMIT=5
SPAM_TIMEOUT_SECONDS=3600
MODERATION_LOG_PATH=moderation.log
MODERATION_DATABASE_PATH=moderation.db
DASHBOARD_URL=https://modstoat.site

# Proton Mail Bridge -> Stoat webhook relay. Keep the webhook URL and Bridge
# password only in the VPS .env; never commit either secret.
EMAIL_RELAY_ENABLED=false
EMAIL_RELAY_WEBHOOK_URL=
STOAT_REPORT_WEBHOOK=
GLOBAL_BAN_SYNC_SECONDS=300
EMAIL_RELAY_RECIPIENT=admin@modstoat.site
# Comma-separated addresses handled as isolated dashboard inboxes. The address
# must also exist as an authorised sender/recipient in Proton Mail Bridge.
EMAIL_RELAY_ADDITIONAL_RECIPIENTS=support@modstoat.site
PROTON_BRIDGE_IMAP_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_IMAP_USERNAME=
PROTON_BRIDGE_IMAP_PASSWORD=
PROTON_BRIDGE_IMAP_MAILBOX=Labels/stoatmod
PROTON_BRIDGE_CA_FILE=/opt/stoatmod/secrets/proton-bridge-ca.pem
PROTON_BRIDGE_SMTP_HOST=127.0.0.1
PROTON_BRIDGE_SMTP_PORT=1025
# Leave these blank to reuse the IMAP username and password.
PROTON_BRIDGE_SMTP_USERNAME=
PROTON_BRIDGE_SMTP_PASSWORD=
EMAIL_RELAY_POLL_SECONDS=30
