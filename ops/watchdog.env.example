# Stoatmod watchdog settings, read by ops/stoatmod_watchdog.py from /opt/stoatmod/ops/watchdog.env.
# Keep the real file private (chmod 600): the webhook URL lets anyone post to that channel.

# Stoat channel webhook for uptime alerts. Leave empty to only log (journalctl -u stoatmod-watchdog).
# Alerts never contain internal details, so a public status channel is fine.
ALERT_WEBHOOK_URL=

# systemd services to watch (comma-separated).
WATCH_SERVICES=stoatmod-bot,stoat-dashboard-api,stoat-dashboard-web

# Optional: the systemd service that tunnels LOCAL_AI_BASE_URL to the AI host. It is watched and restarted.
AI_TUNNEL_SERVICE=

# Optional: SSH access that makes the AI host start its model server. Use a key restricted to one forced command
# in the AI host's authorized_keys, e.g.  restrict,command="/path/to/ensure_service.sh" ssh-ed25519 AAAA...
GPU_HOST=
GPU_PORT=22
GPU_KICK_KEY=
# Optional: known_hosts file holding the AI host key (default /opt/stoatmod/.ssh-ai/known_hosts).
GPU_KNOWN_HOSTS=
