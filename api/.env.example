# Dashboard API (api/server.py). Loaded alongside the bot's root .env.

# Must match the bot: the API reads the same SQLite database.
MODERATION_DATABASE_PATH=moderation.db
STOAT_BOT_TOKEN=
# Stoat user ID allowed to use Stoatmod's global owner features.
GLOBAL_COMMAND_OWNER_ID=

# Public origin of the website, without a trailing slash.
DASHBOARD_ALLOWED_ORIGIN=http://localhost:3000
DASHBOARD_SECURE_COOKIES=false
DASHBOARD_SESSION_HOURS=12

# Keep the API private behind a reverse proxy.
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8081
# Only these proxy addresses may supply X-Forwarded-For.
DASHBOARD_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Cloudflare Turnstile keys for the join CAPTCHA page.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private Stoat webhook that receives global-safety report notifications.
STOAT_REPORT_WEBHOOK=

# Where the status monitor writes service history.
STATUS_HISTORY_PATH=status-history.sqlite3
